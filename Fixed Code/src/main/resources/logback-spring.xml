<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <!-- Task 8: File appender for detailed server-side logs -->
    <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>logs/server.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <fileNamePattern>logs/server.%d{yyyy-MM-dd}.log</fileNamePattern>
            <maxHistory>30</maxHistory>
        </rollingPolicy>
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss} %-5level [%thread] %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <root level="INFO">
        <appender-ref ref="FILE" />
    </root>

    <!-- Task 8: Log all details for error handling -->
    <logger name="edu.nu.owaspapivulnlab.web.GlobalErrorHandler" level="INFO" additivity="false">
        <appender-ref ref="FILE" />
    </logger>
</configuration>
